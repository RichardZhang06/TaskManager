{
  "name": "task-manager",
  "version": "1.0.0",
  "description": "A local task manager",
  "main": "src/main.js",
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder --mac --dir",
    "dist:dmg": "electron-builder --mac dmg"
  },
  "build": {
    "appId": "com.richardzhang.taskmanager",
    "productName": "Task Manager",
    "files": [
      "src/**/*"
    ],
    "mac": {
      "category": "public.app-category.productivity",
      "icon": "build/icon.icns"
    }
  },
  "license": "UNLICENSED",
  "private": true,
  "devDependencies": {
    "electron": "^44.7.0",
    "electron-builder": "^26.15.3"
  }
}
